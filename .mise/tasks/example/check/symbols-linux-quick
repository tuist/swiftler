#!/usr/bin/env bash
#MISE description="Quick test of Linux NIF symbol generation without full SwiftSyntax build"

set -e

if ! command -v docker &> /dev/null; then
    echo "Error: Docker is required but not installed"
    exit 1
fi

echo "Testing NIF symbol generation on Linux (without SwiftSyntax)..."

# Create a simple test that mimics what the macros would generate
cat > /tmp/test-calculator-linux.swift << 'EOF'
import Foundation

// Simulated NIF thunk functions that would be generated by macros
@_cdecl("__swiftler_nif_thunk_add")
public func __swiftler_nif_thunk_add(
    env: OpaquePointer?,
    argc: Int32,
    argv: UnsafePointer<UInt64>?
) -> UInt64 {
    return 42
}

@_cdecl("__swiftler_nif_thunk_multiply")
public func __swiftler_nif_thunk_multiply(
    env: OpaquePointer?,
    argc: Int32,
    argv: UnsafePointer<UInt64>?
) -> UInt64 {
    return 84
}

// The nif_init function
@_cdecl("nif_init")
public func nif_init() -> UnsafeRawPointer? {
    return nil
}
EOF

# Run in Docker
docker run --rm -v "/tmp:/work" -w /work swift:6.0-jammy bash -c '
    echo "=== Compiling test file ==="
    swiftc -emit-library -o test-calculator.so test-calculator-linux.swift
    
    echo -e "\n=== Checking NIF symbols (Linux expects no underscore prefix) ==="
    nm -D test-calculator.so | grep -E "T (nif_init|__swiftler_nif_thunk)" || echo "No NIF symbols found"
    
    echo -e "\n=== All exported symbols ==="
    nm -D test-calculator.so | grep " T " | head -10
    
    echo -e "\n=== Success! The symbol export pattern works correctly on Linux ==="
'

# Cleanup
rm -f /tmp/test-calculator-linux.swift

echo ""
echo "Note: Full calculator build with macros requires more time due to SwiftSyntax compilation."
echo "Consider increasing the timeout or building locally on a Linux machine for full verification."